# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  App_config = debug
  Core_config = debug

else ifeq ($(config),dist)
  App_config = dist
  Core_config = dist

else ifeq ($(config),release)
  App_config = release
  Core_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := Core App

.PHONY: all clean help $(PROJECTS) Core

all: $(PROJECTS)

Core: Core

App: Core
ifneq (,$(App_config))
	@echo "==== Building App ($(App_config)) ===="
	@${MAKE} --no-print-directory -C App -f Makefile config=$(App_config)
endif

Core:
ifneq (,$(Core_config))
	@echo "==== Building Core ($(Core_config)) ===="
	@${MAKE} --no-print-directory -C Core -f Makefile config=$(Core_config)
endif

clean:
	@${MAKE} --no-print-directory -C App -f Makefile clean
	@${MAKE} --no-print-directory -C Core -f Makefile clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  dist"
	@echo "  release"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   App"
	@echo "   Core"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"